# =============================================================
# .env.example — ตัวอย่างค่าตั้งค่า (ไม่มีค่าจริง)
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env ที่ root ของ repo แล้วแก้ค่าตามต้องการ
#   PowerShell:  Copy-Item .env.example .env
# ไฟล์ .env ห้ามขึ้น GitHub (อยู่ใน .gitignore แล้ว)
# =============================================================

# --- ฐานข้อมูล PostgreSQL (docker-compose.yml ใช้ค่ากลุ่มนี้สร้างฐานข้อมูล) ---
POSTGRES_DB=mangosteen
POSTGRES_USER=mangosteen
POSTGRES_PASSWORD=change-me-local-only
# พอร์ตบนเครื่องที่เปิดให้ฐานข้อมูล — ปกติ 5432
# ถ้าเครื่องมี PostgreSQL ตัวอื่นใช้ 5432 อยู่แล้ว (เช่น ติดตั้งบน Windows) ให้เปลี่ยนเป็นพอร์ตอื่น เช่น 5434
POSTGRES_PORT=5432

# --- Django (backend) ---
# ที่อยู่ฐานข้อมูลที่ Django ใช้เชื่อมต่อ — ชื่อผู้ใช้/รหัสผ่าน/ชื่อฐานข้อมูล/พอร์ต ต้องตรงกับกลุ่มด้านบน
# รูปแบบ: postgres://<ผู้ใช้>:<รหัสผ่าน>@<host>:<port>/<ชื่อฐานข้อมูล>
DATABASE_URL=postgres://mangosteen:change-me-local-only@localhost:5432/mangosteen

# กุญแจลับของ Django — ใช้ค่าสุ่มยาว ๆ และห้ามใช้ค่านี้บนเซิร์ฟเวอร์จริง
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# True = โหมดพัฒนา (แสดงรายละเอียด error) ; บนเซิร์ฟเวอร์จริงต้องเป็น False
DJANGO_DEBUG=True

# ชื่อโดเมน/host ที่อนุญาตให้เข้าถึง backend (คั่นด้วยจุลภาค)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# โดเมนของ frontend ที่อนุญาตให้เรียก API ข้ามโดเมน (CORS) — คั่นด้วยจุลภาค
# ตอนพัฒนาในเครื่องเว้นว่างไว้ได้ (frontend เรียกผ่าน proxy ของ Vite)
# ใช้ตอน deploy ถ้า frontend กับ backend อยู่คนละโดเมน เช่น https://campus.example.com
# แผน deploy ที่เลือก (Render — โดเมนเดียวกัน) ไม่ต้องตั้ง — เว้นว่างไว้
CORS_ALLOWED_ORIGINS=
